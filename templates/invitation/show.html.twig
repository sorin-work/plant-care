{% extends 'base.html.twig' %}

{% block title %}Invitation · {{ parent() }}{% endblock %}

{% block body %}
    <section class="card narrow invitation">
        {% if invitation %}
            <h1>Join {{ invitation.household.name }}</h1>
            <p>
                {{ invitation.invitedBy ? invitation.invitedBy.displayName : 'Someone' }} invited you to look after
                the plants of <strong>{{ invitation.household.name }}</strong> as {{ invitation.role.label|lower }}.
            </p>
            {% if not app.user %}
                <p class="actions">
                    <a href="{{ path('app_login') }}" class="btn btn-secondary">Sign in</a>
                    <a href="{{ path('app_register') }}" class="btn">Create an account</a>
                </p>
            {% endif %}
        {% else %}
            <h1>This invitation can't be used</h1>
            <p>It has expired or was already used. Ask for a new link.</p>
        {% endif %}
    </section>
{% endblock %}
