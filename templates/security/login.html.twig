{% extends 'base.html.twig' %}

{% block title %}Sign in · {{ parent() }}{% endblock %}

{% block body %}
    <section class="card narrow">
        <h1>Sign in</h1>
        {% if error %}
            <div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}
        <form method="post">
            <div class="form-row">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus>
            </div>
            <div class="form-row">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" autocomplete="current-password" required>
            </div>
            <div class="form-row checkbox">
                <label><input type="checkbox" name="_remember_me"> Keep me signed in</label>
            </div>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="btn">Sign in</button>
        </form>
        <p class="muted">New here? <a href="{{ path('app_register') }}">Create an account</a></p>
    </section>
{% endblock %}
