<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Plant care{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🪴</text></svg>">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="site-header" data-controller="menu">
            <div class="container">
                <a class="brand" href="{{ path('home') }}">Plant care</a>
                <button type="button" class="menu-toggle" aria-label="Menu" aria-expanded="false" data-menu-target="toggle" data-action="menu#toggle">&#9776;</button>
                {% if app.user %}
                    <nav class="main-nav" data-menu-target="panel">
                        {% set route = app.request.attributes.get('_route') %}
                        <a href="{{ path('home') }}" {{ route == 'home' ? 'aria-current="page"' }}>Today</a>
                        <a href="{{ path('upcoming') }}" {{ route == 'upcoming' ? 'aria-current="page"' }}>Coming up</a>
                        <a href="{{ path('plant_index') }}" {{ route starts with 'plant_' ? 'aria-current="page"' }}>Plants</a>
                        <a href="{{ path('room_index') }}" {{ route starts with 'room_' ? 'aria-current="page"' }}>Rooms</a>
                        <a href="{{ path('species_index') }}" {{ route starts with 'species_' ? 'aria-current="page"' }}>Species</a>
                        <a href="{{ path('household_members') }}" {{ route == 'household_members' ? 'aria-current="page"' }}>Members</a>
                        <a href="{{ path('stats') }}" {{ route == 'stats' ? 'aria-current="page"' }}>Stats</a>
                    </nav>
                {% endif %}
                <nav class="site-nav" data-menu-target="panel">
                    {% if app.user %}
                        {% set households = my_households() %}
                        {% if households|length > 1 %}
                            <form method="post" class="household-switch" action="#" data-controller="household-switch">
                                <select aria-label="Household" data-action="household-switch#go">
                                    {% for membership in households %}
                                        {% set h = membership.household %}
                                        <option value="{{ path('household_switch', {id: h.id}) }}" {{ h.id == current_household().id ? 'selected' }}>{{ h.name }}</option>
                                    {% endfor %}
                                </select>
                                <input type="hidden" name="_token" value="{{ csrf_token('switch-household') }}">
                            </form>
                        {% else %}
                            <span class="muted-inverse">{{ current_household().name }}</span>
                        {% endif %}
                        {% if is_granted('HOUSEHOLD_MANAGE', current_household()) %}
                            <a href="{{ path('household_settings') }}">Settings</a>
                        {% endif %}
                        <a href="{{ path('account') }}">{{ app.user.displayName }}</a>
                        <a href="{{ path('app_logout') }}">Sign out</a>
                    {% else %}
                        <a href="{{ path('app_login') }}">Sign in</a>
                        <a href="{{ path('app_register') }}">Create account</a>
                    {% endif %}
                </nav>
            </div>
        </header>
        <main class="container">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}" role="status" data-controller="dismiss">
                        <span>{{ message }}</span>
                        <button type="button" class="flash-close" data-action="dismiss#close" aria-label="Dismiss">&times;</button>
                    </div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
