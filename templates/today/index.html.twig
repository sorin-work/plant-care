{% extends 'base.html.twig' %}

{% block title %}{{ count ? '(' ~ count ~ ') ' }}Today · {{ parent() }}{% endblock %}

{% block body %}
    <div data-controller="today" data-action="today:changed->today#update">
    <div class="page-header">
        <div>
            <h1>Today</h1>
            <p class="muted">{{ today|date('l, j F') }}<span data-today-target="count">{{ count ? ' · ' ~ count ~ (count == 1 ? ' task' : ' tasks') }}</span></p>
        </div>
    </div>

    {% if not has_plants %}
        <section class="empty onboarding">
            <h2>Welcome to {{ current_household().name }}</h2>
            <p>Add the rooms of your home and the plants that live in them. We will work out when they need water, food and a bigger pot.</p>
            {% if is_granted('HOUSEHOLD_EDIT', current_household()) %}
                <p class="actions">
                    <a href="{{ path('room_index') }}" class="btn btn-secondary">Add rooms</a>
                    <a href="{{ path('plant_new') }}" class="btn">Add your first plant</a>
                </p>
            {% endif %}
        </section>
    {% else %}
        <p class="empty" data-today-target="empty" {{ count > 0 ? 'hidden' }}>All caught up. Nothing needs doing today. 🌿</p>
    {% endif %}
    {% for group in groups %}
        <section class="room-group">
            <div class="room-group-header">
                <h2>{{ group.label }} <span class="muted">({{ group.tasks|length }})</span></h2>
                {% set waterings = group.tasks|filter(t => t.schedule.type.value == 'water' and is_granted('HOUSEHOLD_CARE', t.schedule)) %}
                {% if waterings|length > 1 %}
                    <form method="post" action="{{ path('task_done_many') }}" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('tasks-many') }}">
                        {% for task in waterings %}
                            <input type="hidden" name="ids[]" value="{{ task.schedule.id }}">
                        {% endfor %}
                        <button type="submit" class="btn btn-secondary btn-small">💧 Water all {{ waterings|length }}</button>
                    </form>
                {% endif %}
            </div>
            <ul class="list card tasks">
                {% for task in group.tasks %}
                    {{ include('care/_task_row.html.twig', {task: task, back: path('home')}) }}
                {% endfor %}
            </ul>
        </section>
    {% endfor %}

    {% if snoozed is not empty %}
        <details class="snoozed">
            <summary>{{ snoozed|length }} snoozed</summary>
            <ul class="list card">
                {% for schedule in snoozed %}
                    <li>
                        <span>
                            {{ schedule.type.icon }} {{ schedule.type.label }}
                            <a href="{{ path('plant_show', {id: schedule.plant.id}) }}">{{ schedule.plant.name }}</a>
                            <span class="muted">until {{ schedule.snoozedUntil|date('D j M') }}</span>
                        </span>
                        {% if is_granted('HOUSEHOLD_CARE', schedule) %}
                            <form method="post" action="{{ path('task_wake', {id: schedule.id}) }}" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('task-' ~ schedule.id) }}">
                                <input type="hidden" name="_back" value="{{ path('home') }}">
                                <button type="submit" class="link">Back to today</button>
                            </form>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </details>
    {% endif %}
    </div>
{% endblock %}
