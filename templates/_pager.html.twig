{% if page.pageCount > 1 %}
    <nav class="pager" aria-label="Pages">
        {% if page.hasPrevious %}
            <a href="{{ path(route, params|merge({page: page.number - 1})) }}">&larr; Newer</a>
        {% else %}
            <span></span>
        {% endif %}
        <span class="muted">Page {{ page.number }} of {{ page.pageCount }}</span>
        {% if page.hasNext %}
            <a href="{{ path(route, params|merge({page: page.number + 1})) }}">Older &rarr;</a>
        {% else %}
            <span></span>
        {% endif %}
    </nav>
{% endif %}
