{% extends 'base.html.twig' %}

{% block title %}Members · {{ parent() }}{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Members</h1>
            <p class="muted">People who share the plants of {{ household.name }}.</p>
        </div>
        <a href="{{ path('household_new') }}" class="btn btn-secondary">New household</a>
    </div>

    <ul class="list card members">
        {% for membership in memberships %}
            <li>
                <span>
                    <strong>{{ membership.user.displayName }}</strong>
                    {% if membership.user == app.user %}<span class="muted">(you)</span>{% endif %}
                    <span class="muted">{{ membership.user.email }}</span>
                </span>
                {% if is_granted('HOUSEHOLD_MANAGE', household) %}
                    <span class="actions">
                        <form method="post" action="{{ path('household_member_role', {id: membership.id}) }}" class="inline role-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('member-' ~ membership.id) }}">
                            <select name="role" aria-label="Role of {{ membership.user.displayName }}" onchange="this.form.requestSubmit()">
                                {% for role in enum_cases('App\\Enum\\HouseholdRole') %}
                                    <option value="{{ role.value }}" {{ role == membership.role ? 'selected' }}>{{ role.label }}</option>
                                {% endfor %}
                            </select>
                            <noscript><button type="submit" class="btn btn-small">Change</button></noscript>
                        </form>
                        {% if membership.user != app.user %}
                            <form method="post" action="{{ path('household_member_remove', {id: membership.id}) }}" class="inline" onsubmit="return confirm('Remove {{ membership.user.displayName|e('js') }} from this household?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('member-' ~ membership.id) }}">
                                <button type="submit" class="link danger">Remove</button>
                            </form>
                        {% endif %}
                    </span>
                {% else %}
                    <span class="tag role-{{ membership.role.value }}">{{ membership.role.label }}</span>
                {% endif %}
            </li>
        {% endfor %}
    </ul>

    {% if is_granted('HOUSEHOLD_MANAGE', household) %}
        <section class="card add-member">
            <h2>Add someone</h2>
            {{ form_start(form) }}
                <div class="grid-fields">
                    {{ form_row(form.email) }}
                    {{ form_row(form.role) }}
                </div>
                <button type="submit" class="btn">Add member</button>
            {{ form_end(form) }}
        </section>
    {% endif %}

    <form method="post" action="{{ path('household_leave') }}" class="danger-zone" onsubmit="return confirm('Leave {{ household.name|e('js') }}? You will lose access to its plants.')">
        <input type="hidden" name="_token" value="{{ csrf_token('leave-household') }}">
        <button type="submit" class="link danger">Leave {{ household.name }}</button>
        {% if memberships|length == 1 %}
            <p class="help-text">You are the only member: leaving deletes the household and all its plants.</p>
        {% endif %}
    </form>

    <section class="card roles-help">
        <h2>Roles</h2>
        <dl class="facts">
            <dt>Owner</dt><dd>Everything, including settings and members.</dd>
            <dt>Editor</dt><dd>Adds and edits plants, rooms and schedules, takes care of tasks.</dd>
            <dt>Viewer</dt><dd>Can look at plants, tasks and the journal.</dd>
        </dl>
    </section>
{% endblock %}
