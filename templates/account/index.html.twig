{% extends 'base.html.twig' %}

{% block title %}Account · {{ parent() }}{% endblock %}

{% block body %}
    <h1>Account</h1>

    <section class="card">
        <h2>API token</h2>
        <p class="muted">Use a personal token to read your plants and tasks from scripts or other apps. See <code>docs/api.md</code>.</p>

        {% if new_token is defined %}
            <div class="notice token">
                <p>Copy your new token now, it will not be shown again:</p>
                <code class="token-value">{{ new_token }}</code>
            </div>
        {% elseif app.user.apiTokenHash %}
            <p>You have a token created on {{ app.user.apiTokenCreatedAt|date('j M Y') }}.</p>
        {% endif %}

        <div class="actions">
            <form method="post" action="{{ path('account_token') }}" class="inline">
                <input type="hidden" name="_token" value="{{ csrf_token('api-token') }}">
                <button type="submit" class="btn">{{ app.user.apiTokenHash ? 'Replace token' : 'Create token' }}</button>
            </form>
            {% if app.user.apiTokenHash %}
                <form method="post" action="{{ path('account_token_revoke') }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('api-token') }}">
                    <button type="submit" class="link danger">Revoke</button>
                </form>
            {% endif %}
        </div>
    </section>
{% endblock %}
