{% extends 'base.html.twig' %}

{% block title %}Account · {{ parent() }}{% endblock %}

{% block body %}
    <h1>Account</h1>
    <div class="stack">
    <div class="grid-fields">
        <section class="card">
            <h2>Profile</h2>
            {{ form_start(profile) }}
                {{ form_row(profile.displayName) }}
                <p class="muted">Signed in as {{ app.user.email }}</p>
                <button type="submit" class="btn">Save profile</button>
            {{ form_end(profile) }}
        </section>
        <section class="card">
            <h2>Password</h2>
            {{ form_start(password) }}
                {{ form_row(password.current) }}
                {{ form_row(password.password.first) }}
                {{ form_row(password.password.second) }}
                <button type="submit" class="btn">Change password</button>
            {{ form_end(password) }}
        </section>
    </div>

    <section class="card">
        <h2>Calendar</h2>
        <p class="muted">Subscribe to your care schedule in Google Calendar, Apple Calendar or Outlook.</p>
        {% if app.user.calendarToken %}
            {% set feed = url('calendar_feed', {token: app.user.calendarToken}) %}
            <code class="token-value">{{ feed }}</code>
            <p class="help-text">Anyone with this link can see your plants' schedule. Replace it if it leaked.</p>
        {% endif %}
        <form method="post" action="{{ path('account_calendar') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('calendar-feed') }}">
            <button type="submit" class="btn btn-secondary">{{ app.user.calendarToken ? 'Replace calendar link' : 'Create calendar link' }}</button>
        </form>
    </section>

    <section class="card">
        <h2>API token</h2>
        <p class="muted">Use a personal token to read your plants and tasks from scripts or other apps. See <code>docs/api.md</code>.</p>

        {% if new_token is defined %}
            <div class="notice token">
                <p>Copy your new token now, it will not be shown again:</p>
                <code class="token-value">{{ new_token }}</code>
            </div>
        {% elseif app.user.apiTokenHash %}
            <p>You have a token created on {{ app.user.apiTokenCreatedAt|date('j M Y') }}.</p>
        {% endif %}

        <div class="actions">
            <form method="post" action="{{ path('account_token') }}" class="inline">
                <input type="hidden" name="_token" value="{{ csrf_token('api-token') }}">
                <button type="submit" class="btn">{{ app.user.apiTokenHash ? 'Replace token' : 'Create token' }}</button>
            </form>
            {% if app.user.apiTokenHash %}
                <form method="post" action="{{ path('account_token_revoke') }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('api-token') }}">
                    <button type="submit" class="link danger">Revoke</button>
                </form>
            {% endif %}
        </div>
    </section>
    </div>
{% endblock %}
