{% apply inline_css %}
<style>
    body { font-family: system-ui, sans-serif; color: #2b2b27; }
    h1 { color: #163f25; font-size: 20px; }
    h2 { font-size: 15px; margin: 20px 0 6px; color: #256b3d; }
    li { margin: 4px 0; }
    .late { color: #b42318; }
</style>
<h1>Good morning, {{ user.displayName }}!</h1>
<p>{{ count }} {{ count == 1 ? 'task is' : 'tasks are' }} waiting for you today.</p>
{% for section in sections %}
    <h2>{{ section.household.name }}</h2>
    <ul>
        {% for task in section.tasks %}
            <li>
                {{ task.schedule.type.icon }} {{ task.schedule.type.label }} <strong>{{ task.plant.name }}</strong>
                {% if task.plant.room %}({{ task.plant.room.name }}){% endif %}
                {% if task.overdue %}<span class="late">{{ task.daysOverdue }} {{ task.daysOverdue == 1 ? 'day' : 'days' }} late</span>{% endif %}
            </li>
        {% endfor %}
    </ul>
{% endfor %}
<p><a href="{{ url('home') }}">Open today's list</a> · <a href="{{ url('account') }}">Email settings</a></p>
{% endapply %}
