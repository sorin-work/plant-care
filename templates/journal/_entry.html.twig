<article class="journal-entry">
    <header>
        <strong>{{ entry.writtenOn|date('j M Y') }}</strong>
        {% if entry.author %}<span class="muted">· {{ entry.author.displayName }}</span>{% endif %}
        {% if (entry.author == app.user and is_granted('HOUSEHOLD_CARE', entry)) or is_granted('HOUSEHOLD_MANAGE', entry) %}
            <form method="post" action="{{ path('journal_delete', {id: entry.id}) }}" class="inline entry-delete" onsubmit="return confirm('Delete this journal entry?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-entry-' ~ entry.id) }}">
                <button type="submit" class="link danger">Delete</button>
            </form>
        {% endif %}
    </header>
    <p>{{ entry.note|autolink|nl2br }}</p>
    {% if entry.photo %}
        <a href="{{ path('photo_show', {name: entry.photo}) }}" target="_blank">
            <img src="{{ path('photo_show', {name: entry.photo}) }}" alt="Photo of {{ entry.plant.name }} on {{ entry.writtenOn|date('j M Y') }}" class="journal-photo" loading="lazy">
        </a>
    {% endif %}
</article>
