{{ form_start(form, {attr: {'data-controller': 'species-defaults'}}) }}
    {{ form_row(form.name) }}
    <p class="notice species-hint" data-species-defaults-target="hint" hidden></p>
    <div class="grid-fields">
        {{ form_row(form.species) }}
        {{ form_row(form.room) }}
        {{ form_row(form.light) }}
        {{ form_row(form.acquiredOn) }}
    </div>
    {{ form_row(form.notes) }}
    {{ include('_photo_field.html.twig', {field: form.coverFile}) }}
    <button type="submit" class="btn">{{ button_label }}</button>
    <a href="{{ cancel_path }}" class="btn btn-secondary">Cancel</a>
{{ form_end(form) }}
