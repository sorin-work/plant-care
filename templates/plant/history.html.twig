{% extends 'base.html.twig' %}

{% block title %}Care history · {{ plant.name }} · {{ parent() }}{% endblock %}

{% block body %}
    <p><a href="{{ path('plant_show', {id: plant.id}) }}">&larr; {{ plant.name }}</a></p>
    <h1>Care history</h1>

    {% if page.items is empty %}
        <p class="empty">Nothing logged yet.</p>
    {% else %}
        <table class="table history-table">
            <thead>
                <tr><th>Date</th><th>Care</th><th>What happened</th><th>By</th></tr>
            </thead>
            <tbody>
                {% for event in page.items %}
                    <tr>
                        <td>{{ event.happenedOn|date('D j M Y') }}</td>
                        <td>{{ event.type.icon }} {{ event.type.label }}</td>
                        <td>{{ event.action.value|capitalize }}</td>
                        <td>{{ event.user ? event.user.displayName : '—' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {{ include('_pager.html.twig', {route: 'plant_history', params: {id: plant.id}}) }}
    {% endif %}
{% endblock %}
