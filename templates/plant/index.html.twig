{% extends 'base.html.twig' %}

{% block title %}Plants · {{ parent() }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Plants</h1>
        <div class="actions">
            <a href="{{ path('plant_archived') }}">Archive</a>
            {% if is_granted('HOUSEHOLD_EDIT', current_household()) %}
                <a href="{{ path('plant_new') }}" class="btn">Add a plant</a>
            {% endif %}
        </div>
    </div>

    {% if rooms|length > 1 %}
        <nav class="chips" aria-label="Filter by room">
            <a href="{{ path('plant_index') }}" class="chip {{ selected_room is null ? 'is-active' }}">All rooms</a>
            {% for room in rooms %}
                <a href="{{ path('plant_index', {room: room.id}) }}" class="chip {{ selected_room and selected_room.id == room.id ? 'is-active' }}">{{ room.name }}</a>
            {% endfor %}
        </nav>
    {% endif %}

    {% if plants is empty and selected_room %}
        <p class="empty">No plants in {{ selected_room.name }}.</p>
    {% elseif plants is empty %}
        <p class="empty">No plants yet. <a href="{{ path('plant_new') }}">Add your first plant</a>.</p>
    {% else %}
        <ul class="plant-grid">
            {% for plant in plants %}
                <li class="card plant-card">
                    {% if plant.coverPhoto %}
                        <img src="{{ path('photo_show', {name: plant.coverPhoto}) }}" alt="" class="plant-cover" loading="lazy">
                    {% else %}
                        <div class="plant-cover plant-cover-empty" aria-hidden="true">🪴</div>
                    {% endif %}
                    <h2><a href="{{ path('plant_show', {id: plant.id}) }}">{{ plant.name }}</a></h2>
                    {% if plant.species %}
                        <p class="muted"><em>{{ plant.species.scientificName }}</em></p>
                    {% endif %}
                    <p class="tags">
                        <span class="tag">{{ plant.room ? plant.room.name : 'No room' }}</span>
                        <span class="tag">{{ plant.light.label }}</span>
                    </p>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
