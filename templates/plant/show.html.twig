{% extends 'base.html.twig' %}

{% block title %}{{ plant.name }} · {{ parent() }}{% endblock %}

{% block body %}
    <p><a href="{{ path('plant_index') }}">&larr; All plants</a></p>
    {% if plant.archived %}
        <p class="notice">Archived on {{ plant.archivedAt|date('j M Y') }}. Archived plants have no care tasks.</p>
    {% endif %}
    <div class="page-header">
        <div>
            <h1>{{ plant.name }}</h1>
            {% if plant.species %}
                <p class="muted"><a href="{{ path('species_show', {id: plant.species.id}) }}">{{ plant.species.commonName }}</a> · <em>{{ plant.species.scientificName }}</em></p>
            {% endif %}
        </div>
        <div class="actions">
            {% if plant.archived %}
                <form method="post" action="{{ path('plant_restore', {id: plant.id}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('restore-plant-' ~ plant.id) }}">
                    <button type="submit" class="btn">Restore</button>
                </form>
            {% else %}
                <a href="{{ path('plant_edit', {id: plant.id}) }}" class="btn btn-secondary">Edit</a>
                <form method="post" action="{{ path('plant_archive', {id: plant.id}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('archive-plant-' ~ plant.id) }}">
                    <button type="submit" class="btn btn-secondary">Archive</button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="grid-2">
        <section class="card">
            <h2>Notes</h2>
            {% if plant.notes %}
                <p class="prewrap">{{ plant.notes }}</p>
            {% else %}
                <p class="muted">No notes yet.</p>
            {% endif %}
        </section>
        <aside class="card">
            <dl class="facts">
                <dt>Room</dt><dd>{{ plant.room ? plant.room.name : '—' }}</dd>
                <dt>Light</dt><dd>{{ plant.light.label }}</dd>
                <dt>Since</dt><dd>{{ plant.acquiredOn ? plant.acquiredOn|date('j M Y') : '—' }}</dd>
                {% if plant.species and plant.species.toxicToPets %}
                    <dt>Pets</dt><dd class="danger">Toxic to cats and dogs</dd>
                {% endif %}
            </dl>
        </aside>
    </div>
{% endblock %}
