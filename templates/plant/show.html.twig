{% extends 'base.html.twig' %}

{% block title %}{{ plant.name }} · {{ parent() }}{% endblock %}

{% block body %}
    <p><a href="{{ path('plant_index') }}">&larr; All plants</a></p>
    {% if plant.archived %}
        <p class="notice">Archived on {{ plant.archivedAt|date('j M Y') }}. Archived plants have no care tasks.</p>
    {% endif %}
    <div class="page-header">
        <div>
            <h1>{{ plant.name }}</h1>
            {% if plant.species %}
                <p class="muted"><a href="{{ path('species_show', {id: plant.species.id}) }}">{{ plant.species.commonName }}</a> · <em>{{ plant.species.scientificName }}</em></p>
            {% endif %}
        </div>
        {% set can_edit = is_granted('HOUSEHOLD_EDIT', plant) %}
        {% set can_care = is_granted('HOUSEHOLD_CARE', plant) %}
        {% if can_edit %}
        <div class="actions">
            {% if plant.archived %}
                <form method="post" action="{{ path('plant_restore', {id: plant.id}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('restore-plant-' ~ plant.id) }}">
                    <button type="submit" class="btn">Restore</button>
                </form>
            {% else %}
                <a href="{{ path('plant_edit', {id: plant.id}) }}" class="btn btn-secondary">Edit</a>
                <form method="post" action="{{ path('plant_archive', {id: plant.id}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('archive-plant-' ~ plant.id) }}">
                    <button type="submit" class="btn btn-secondary">Archive</button>
                </form>
            {% endif %}
        </div>
        {% endif %}
    </div>

    <div class="grid-2">
        <div class="stack">
        {% if not plant.archived %}
            <section class="card">
                <h2>Care</h2>
                <ul class="list schedules">
                    {% for schedule in plant.schedules %}
                        <li>
                            <span>
                                <span aria-hidden="true">{{ schedule.type.icon }}</span>
                                <strong>{{ schedule.type.label }}</strong>
                                <span class="muted">
                                    every {{ schedule.intervalDays }} days{{ schedule.seasonal ? ', seasonal' }}
                                    · next {{ schedule.nextDueOn|date('j M') }}
                                    {% if schedule.snoozedUntil and schedule.snoozedUntil > schedule.nextDueOn %}
                                        · snoozed until {{ schedule.snoozedUntil|date('j M') }}
                                    {% endif %}
                                    {% if schedule.lastDoneOn %}
                                        · last done {{ schedule.lastDoneOn|date('j M') }}
                                    {% endif %}
                                </span>
                            </span>
                            <span class="actions">
                                {% if can_edit %}
                                    <a href="{{ path('schedule_edit', {id: schedule.id}) }}">Edit</a>
                                {% endif %}
                                {% if can_care %}
                                    <form method="post" action="{{ path('task_done', {id: schedule.id}) }}" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('task-' ~ schedule.id) }}">
                                        <button type="submit" class="btn btn-small">Done</button>
                                    </form>
                                {% endif %}
                            </span>
                        </li>
                    {% else %}
                        <li class="muted">No care schedules.</li>
                    {% endfor %}
                </ul>
                {% set used = plant.schedules|map(s => s.type.value) %}
                {% for type in enum_cases('App\\Enum\\CareTaskType') %}
                    {% if can_edit and type.value not in used %}
                        <a href="{{ path('schedule_new', {id: plant.id, type: type.value}) }}" class="btn btn-secondary btn-small">+ {{ type.label }} reminders</a>
                    {% endif %}
                {% endfor %}
            </section>
        {% endif %}
        <section class="card">
            <h2>Notes</h2>
            {% if plant.notes %}
                <p class="prewrap">{{ plant.notes }}</p>
            {% else %}
                <p class="muted">No notes yet.</p>
            {% endif %}
        </section>
        <section class="card">
            <h2>Journal</h2>
            {% if can_care and not plant.archived %}
                {{ include('journal/_form.html.twig') }}
            {% endif %}
            {% for entry in entries %}
                {{ include('journal/_entry.html.twig') }}
            {% else %}
                <p class="muted">No journal entries yet.</p>
            {% endfor %}
            {% if entries|length > 0 %}
                <p><a href="{{ path('journal_index', {id: plant.id}) }}">Whole journal &rarr;</a></p>
            {% endif %}
        </section>
        <section class="card">
            <h2>Recent care</h2>
            {% if events is empty %}
                <p class="muted">Nothing logged yet.</p>
            {% else %}
                <ul class="list history">
                    {% for event in events %}
                        <li>
                            <span>{{ event.type.icon }} {{ event.type.label }} · {{ event.action.value }}</span>
                            <span class="muted">{{ event.happenedOn|date('j M Y') }}{{ event.user ? ' by ' ~ event.user.displayName }}</span>
                        </li>
                    {% endfor %}
                </ul>
                <p><a href="{{ path('plant_history', {id: plant.id}) }}">Full history &rarr;</a></p>
            {% endif %}
        </section>
        </div>
        <aside class="card">
            {% if plant.coverPhoto %}
                <img src="{{ path('photo_show', {name: plant.coverPhoto}) }}" alt="{{ plant.name }}" class="plant-cover plant-cover-large">
            {% endif %}
            <dl class="facts">
                <dt>Room</dt><dd>{{ plant.room ? plant.room.name : '—' }}</dd>
                <dt>Light</dt><dd>{{ plant.light.label }}</dd>
                <dt>Since</dt><dd>{{ plant.acquiredOn ? plant.acquiredOn|date('j M Y') : '—' }}</dd>
                {% if plant.species and plant.species.toxicToPets %}
                    <dt>Pets</dt><dd class="danger">Toxic to cats and dogs</dd>
                {% endif %}
            </dl>
        </aside>
    </div>
{% endblock %}
