{% extends 'base.html.twig' %}

{% block title %}Archived plants · {{ parent() }}{% endblock %}

{% block body %}
    <p><a href="{{ path('plant_index') }}">&larr; All plants</a></p>
    <h1>Archived plants</h1>
    {% if plants is empty %}
        <p class="empty">Nothing in the archive. Plants you give away or lose end up here.</p>
    {% else %}
        <ul class="list card">
            {% for plant in plants %}
                <li>
                    <a href="{{ path('plant_show', {id: plant.id}) }}">{{ plant.name }}</a>
                    <span class="muted">archived {{ plant.archivedAt|date('j M Y') }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
